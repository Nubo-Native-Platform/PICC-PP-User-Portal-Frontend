# ==============================================================================
# PICC-PP-User-Portal-Frontend - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' and populate with your environment-specific values.
# Do NOT commit '.env' or real production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Base Path Configuration
# ------------------------------------------------------------------------------
# Port for local dev server or container runtime (Default: 8080 / 3006 for Vite)
PORT=8080

# Base URL path where the user portal is served (Default: /nnp-login/)
VITE_BASE_URL=/nnp-login/

# ------------------------------------------------------------------------------
# 2. Platform Core Services & Ingress Gateways
# ------------------------------------------------------------------------------
# Base domain URL for platform services
VITE_APP_DOMAIN=http://localhost:3000/domain

# User Dashboard Service URL
VITE_DASH_HOST=http://localhost:3000/nnpdash

# Platform Authentication Gateway URL (Keycloak / Auth service)
VITE_AUTH_HOST=http://localhost:3000/nnp

# Configuration Service Endpoints (Public & Authenticated)
VITE_NNP_CONFT=http://localhost:3000/nnpconf
VITE_NNP_CONFT_PUB=http://localhost:3000/nnpconf-pub

# Public API Gateway
VITE_API_GW_PUB=http://localhost:3000/api-gw-pub

# Payments Service Endpoint
VITE_API_PAYMENT=http://localhost:3000/payments

# Kubernetes Integration Microservice APIs
VITE_API_KI=http://localhost:3000/k8s-intg
VITE_API_KI_PUB=http://localhost:3000/k8s-intg-pub

# AI Q&A Stream Endpoint
VITE_API_QA=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. External Portals & Single Sign-On (SSO) Links
# ------------------------------------------------------------------------------
# Platform Documentation URL
VITE_DOCS_URL=https://docs.example.com/nnp-docs/

# Home Landing Page URL
VITE_HOME_URL=/

# Keycloak Identity Provider URLs
VITE_KEYCLOAK_ACCOUNT_URL=https://keycloak.example.com/comm/auth/realms/devops/account
VITE_KEYCLOAK_RESET_CREDENTIALS_URL=https://keycloak.example.com/comm/auth/realms/devops/login-actions/reset-credentials

# ------------------------------------------------------------------------------
# 4. Session & Cookie Policy
# ------------------------------------------------------------------------------
# Cookie domain scope (e.g., .localhost for dev, .example.com for production)
VITE_COOKIE_DOMAIN=.localhost

# Localhost Flag (true / false)
VITE_LOCALHOST=true

# Production Mode Flag (true / false)
PRODUCTION=false
